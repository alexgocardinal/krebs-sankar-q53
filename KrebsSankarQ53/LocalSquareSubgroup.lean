import KrebsSankarQ53.OrbitKleinNormal

/-!
# The central square subgroup in the local group

The two elements `1` and `x²` form a subgroup. When `x` moves an
involution and there is no D8 section, it has order two, lies inside
the subgroup generated by `x` and `t`, and is normal there.
-/

namespace KrebsSankarQ53

/-- The subgroup with elements `1` and a specified involution. -/
def squarePairSubgroup {G : Type*} [Group G] (w : G)
    (hw : w * w = 1) : Subgroup G := by
  have hwinv : w⁻¹ = w := by
    calc
      w⁻¹ = w⁻¹ * (w * w) := by rw [hw]; simp
      _ = w := by group
  refine
    { carrier := {z | z = 1 ∨ z = w}
      one_mem' := Or.inl rfl
      mul_mem' := ?_
      inv_mem' := ?_ }
  · intro a b ha hb
    change a = 1 ∨ a = w at ha
    change b = 1 ∨ b = w at hb
    change a * b = 1 ∨ a * b = w
    rcases ha with ha | ha
    · rcases hb with hb | hb
      · exact Or.inl (by rw [ha, hb]; simp)
      · exact Or.inr (by rw [ha, hb]; simp)
    · rcases hb with hb | hb
      · exact Or.inr (by rw [ha, hb]; simp)
      · exact Or.inl (by rw [ha, hb]; exact hw)
  · intro a ha
    change a = 1 ∨ a = w at ha
    change a⁻¹ = 1 ∨ a⁻¹ = w
    rcases ha with rfl | rfl
    · exact Or.inl inv_one
    · exact Or.inr hwinv

theorem squarePairSubgroup_card_two
    {G : Type*} [Group G] (w : G) (hw : w * w = 1)
    (hne : w ≠ 1) : Nat.card (squarePairSubgroup w hw) = 2 := by
  classical
  let W : Subgroup G := squarePairSubgroup w hw
  have hset : (W : Set G) = ↑({1, w} : Finset G) := by
    ext z
    change (z = 1 ∨ z = w) ↔ z ∈ ({1, w} : Finset G)
    simp only [Finset.mem_insert, Finset.mem_singleton]
  change (W : Set G).ncard = 2
  rw [hset, Set.ncard_coe_finset]
  simp [hne.symm]

theorem local_square_pair_mem_closure
    {G : Type*} [Group G] (hG : ExponentFour G)
    (x t : G) :
    squarePairSubgroup (x ^ 2) (square_is_involution hG x) ≤
      Subgroup.closure ({x, t} : Set G) := by
  intro z hz
  change z = 1 ∨ z = x ^ 2 at hz
  rcases hz with rfl | rfl
  · exact Subgroup.one_mem _
  · exact square_mem_closure_pair x t

theorem local_square_pair_normal
    {G : Type*} [Group G] (hG : ExponentFour G)
    (hno : ¬ HasD8Section G) (x t : G) (ht : t * t = 1) :
    ((squarePairSubgroup (x ^ 2) (square_is_involution hG x)).subgroupOf
      (Subgroup.closure ({x, t} : Set G))).Normal := by
  let H : Subgroup G := Subgroup.closure ({x, t} : Set G)
  let W : Subgroup G := squarePairSubgroup (x ^ 2) (square_is_involution hG x)
  have hcentral := square_centralizes_two_generator_subgroup_of_no_d8
    hG hno x t ht
  have hnormalizer : H ≤ Subgroup.normalizer (W : Set G) := by
    intro y hy
    rw [Subgroup.mem_normalizer_iff]
    intro a
    have hcomm : y * x ^ 2 = x ^ 2 * y := hcentral ⟨y, hy⟩
    have hback : y⁻¹ * x ^ 2 * y = x ^ 2 := by
      calc
        y⁻¹ * x ^ 2 * y = y⁻¹ * (x ^ 2 * y) := by group
        _ = y⁻¹ * (y * x ^ 2) := by rw [hcomm]
        _ = x ^ 2 := by group
    constructor
    · intro ha
      change a = 1 ∨ a = x ^ 2 at ha
      change y * a * y⁻¹ = 1 ∨ y * a * y⁻¹ = x ^ 2
      rcases ha with ha | ha
      · left
        rw [ha]
        group
      · right
        rw [ha]
        calc
          y * x ^ 2 * y⁻¹ = (x ^ 2 * y) * y⁻¹ := by rw [hcomm]
          _ = x ^ 2 := by group
    · intro ha
      change y * a * y⁻¹ = 1 ∨ y * a * y⁻¹ = x ^ 2 at ha
      change a = 1 ∨ a = x ^ 2
      rcases ha with ha | ha
      · left
        calc
          a = y⁻¹ * (y * a * y⁻¹) * y := by group
          _ = 1 := by rw [ha]; group
      · right
        calc
          a = y⁻¹ * (y * a * y⁻¹) * y := by group
          _ = x ^ 2 := by rw [ha]; exact hback
  exact Subgroup.normal_subgroupOf_of_le_normalizer hnormalizer

/-- A central order-two subgroup disjoint from the four-element orbit
subgroup except at the identity, under the moved-involution hypothesis. -/
theorem local_square_pair_outside_orbit
    {G : Type*} [Group G] (hG : ExponentFour G)
    (hno : ¬ HasD8Section G) {x t : G}
    (ht : t * t = 1) (hne : x * t ≠ t * x) :
    Nat.card (squarePairSubgroup (x ^ 2) (square_is_involution hG x)) = 2 ∧
    x ^ 2 ∉ orbitKleinSubgroup t (x * t * x⁻¹) ht
      (conjugate_involution ht)
      (local_orbit_involutions_commute hG hno x t ht) := by
  exact ⟨squarePairSubgroup_card_two (x ^ 2) (square_is_involution hG x)
    (noncentral_involution_conjugator_order_four hG hno ht hne),
    square_not_mem_orbit_klein hG hno ht hne⟩

end KrebsSankarQ53
