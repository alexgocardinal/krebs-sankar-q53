import KrebsSankarQ53.PairCentralNormal

/-!
# Images of a pair modulo its central subgroup

The squares and commutator vanish in every normal quotient containing
the subgroup generated by those three elements. Thus the images of
the pair are commuting involutions.
-/

namespace KrebsSankarQ53

theorem pair_images_commute_and_square_one
    {G : Type*} [Group G] (x y : G)
    (N : Subgroup G) [N.Normal]
    (hN : pairCentralSubgroup x y ≤ N) :
    let q : G →* G ⧸ N := QuotientGroup.mk' N
    q x * q x = 1 ∧ q y * q y = 1 ∧ q x * q y = q y * q x := by
  let q : G →* G ⧸ N := QuotientGroup.mk' N
  have hxC : x ^ 2 ∈ pairCentralSubgroup x y :=
    Subgroup.subset_closure (by simp)
  have hyC : y ^ 2 ∈ pairCentralSubgroup x y :=
    Subgroup.subset_closure (by simp)
  have hxN : x * x ∈ N := by
    simpa only [pow_two] using hN hxC
  have hyN : y * y ∈ N := by
    simpa only [pow_two] using hN hyC
  have hcN : commutatorTerm x y ∈ N := by
    apply hN
    exact Subgroup.subset_closure (by simp)
  have hqcomm : commutatorTerm (q x) (q y) = 1 := by
    have hzero : q (commutatorTerm x y) = 1 := by
      simpa only [q, QuotientGroup.mk'_apply] using
        (QuotientGroup.eq_one_iff (commutatorTerm x y)).2 hcN
    simpa [q, commutatorTerm, map_mul] using hzero
  refine ⟨?_, ?_, (commutatorTerm_eq_one_iff (q x) (q y)).mp hqcomm⟩
  · calc
      q x * q x = q (x * x) := (map_mul q x x).symm
      _ = 1 := by
        simpa only [q, QuotientGroup.mk'_apply] using
          (QuotientGroup.eq_one_iff (x * x)).2 hxN
  · calc
      q y * q y = q (y * y) := (map_mul q y y).symm
      _ = 1 := by
        simpa only [q, QuotientGroup.mk'_apply] using
          (QuotientGroup.eq_one_iff (y * y)).2 hyN

theorem pair_image_product_square_one
    {G : Type*} [Group G] (x y : G)
    (N : Subgroup G) [N.Normal]
    (hN : pairCentralSubgroup x y ≤ N) :
    let q : G →* G ⧸ N := QuotientGroup.mk' N
    q (x * y) * q (x * y) = 1 := by
  let q : G →* G ⧸ N := QuotientGroup.mk' N
  have h := pair_images_commute_and_square_one x y N hN
  change q x * q x = 1 ∧ q y * q y = 1 ∧ q x * q y = q y * q x at h
  rcases h with ⟨hx, hy, hcomm⟩
  change q (x * y) * q (x * y) = 1
  rw [map_mul]
  calc
    (q x * q y) * (q x * q y) = (q x * q x) * (q y * q y) := by
      calc
        _ = q x * (q y * q x) * q y := by group
        _ = q x * (q x * q y) * q y := by rw [hcomm]
        _ = (q x * q x) * (q y * q y) := by group
    _ = 1 := by rw [hx, hy, one_mul]

end KrebsSankarQ53
