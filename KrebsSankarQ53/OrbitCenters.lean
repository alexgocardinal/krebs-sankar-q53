import KrebsSankarQ53.OrbitCentralizer

/-!
# Two central involutions in the local subgroup

For a noncentral involution `t` and a group element `x` moving it,
the elements `x²` and `t * (x t x⁻¹)` are nontrivial involutions that
centralize the subgroup generated by `x` and `t`. They may coincide;
the later argument must treat that case and the distinct case.
-/

namespace KrebsSankarQ53

/-- A group element commuting with both generators commutes with their
entire generated subgroup. -/
theorem commutes_with_closure_pair
    {G : Type*} [Group G] (x t z : G)
    (hx : x * z = z * x) (ht : t * z = z * t) :
    ∀ y : Subgroup.closure ({x, t} : Set G),
      (y : G) * z = z * (y : G) := by
  have hx' : x ∈ Subgroup.centralizer ({z} : Set G) :=
    Subgroup.mem_centralizer_singleton_iff.mpr hx
  have ht' : t ∈ Subgroup.centralizer ({z} : Set G) :=
    Subgroup.mem_centralizer_singleton_iff.mpr ht
  have hgen : ({x, t} : Set G) ⊆ Subgroup.centralizer ({z} : Set G) := by
    intro w hw
    have hw' : w = x ∨ w = t := by simpa using hw
    rcases hw' with hwx | hwt
    · rw [hwx]
      exact hx'
    · rw [hwt]
      exact ht'
  have hle : Subgroup.closure ({x, t} : Set G) ≤
      Subgroup.centralizer ({z} : Set G) :=
    (Subgroup.closure_le _).2 hgen
  intro y
  exact (Subgroup.mem_centralizer_singleton_iff).1 (hle y.property)

theorem involutionOrbitProduct_centralizes_two_generator_subgroup
    {G : Type*} [Group G] (hG : ExponentFour G)
    (hno : ¬ HasD8Section G) (x t : G) (ht : t * t = 1) :
    ∀ y : Subgroup.closure ({x, t} : Set G),
      (y : G) * involutionOrbitProduct x t =
        involutionOrbitProduct x t * (y : G) := by
  have hp : involutionOrbitProduct x t * involutionOrbitProduct x t = 1 :=
    involutionOrbitProduct_involution hG hno x t ht
  have htx : t * involutionOrbitProduct x t =
      involutionOrbitProduct x t * t :=
    no_d8_section_involutions_commute hG hno t
      (involutionOrbitProduct x t) ht hp
  exact commutes_with_closure_pair x t (involutionOrbitProduct x t)
    (involutionOrbitProduct_commutes_with_conjugator hG hno x t ht) htx

end KrebsSankarQ53
