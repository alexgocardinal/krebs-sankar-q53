import KrebsSankarQ53.OrbitSquareSeparation

/-!
# The four-element subgroup generated by commuting involutions

The carrier has the four normal forms `1`, `t`, `u`, and `t*u`.
We use it for the pair `t`, `x*t*x⁻¹` when no D8 section exists.
-/

namespace KrebsSankarQ53

/-- The four possible products of two commuting involutions form a subgroup.
Some of the four forms may coincide until distinctness is separately proved. -/
def orbitKleinSubgroup {G : Type*} [Group G] (t u : G)
    (ht : t * t = 1) (hu : u * u = 1)
    (hc : t * u = u * t) : Subgroup G := by
  have htu : t * (t * u) = u := by
    calc
      t * (t * u) = (t * t) * u := by rw [mul_assoc]
      _ = u := by rw [ht, one_mul]
  have hut : (t * u) * t = u := by
    calc
      (t * u) * t = t * (u * t) := by rw [mul_assoc]
      _ = t * (t * u) := by rw [← hc]
      _ = u := htu
  have huu : u * (t * u) = t := by
    calc
      u * (t * u) = (u * t) * u := by rw [mul_assoc]
      _ = (t * u) * u := by rw [← hc]
      _ = t := by rw [mul_assoc, hu, mul_one]
  have htu' : (t * u) * u = t := by rw [mul_assoc, hu, mul_one]
  have hp : (t * u) * (t * u) = 1 := by
    calc
      (t * u) * (t * u) = ((t * u) * t) * u := by group
      _ = u * u := by rw [hut]
      _ = 1 := hu
  have hinv (z : G) (hz : z * z = 1) : z⁻¹ = z := by
    calc
      z⁻¹ = z⁻¹ * (z * z) := by rw [hz]; simp
      _ = z := by group
  refine
    { carrier := {z | z = 1 ∨ z = t ∨ z = u ∨ z = t * u}
      one_mem' := Or.inl rfl
      mul_mem' := ?_
      inv_mem' := ?_ }
  · intro a b ha hb
    change a = 1 ∨ a = t ∨ a = u ∨ a = t * u at ha
    change b = 1 ∨ b = t ∨ b = u ∨ b = t * u at hb
    change a * b = 1 ∨ a * b = t ∨ a * b = u ∨ a * b = t * u
    rcases ha with ha | ha | ha | ha <;>
      rcases hb with hb | hb | hb | hb <;>
      rw [ha, hb] <;>
      simp [ht, hu, hp, ← hc, htu, hut, huu, htu']
  · intro a ha
    change a = 1 ∨ a = t ∨ a = u ∨ a = t * u at ha
    change a⁻¹ = 1 ∨ a⁻¹ = t ∨ a⁻¹ = u ∨ a⁻¹ = t * u
    rcases ha with ha | ha | ha | ha
    · rw [ha]
      exact Or.inl (inv_one)
    · rw [ha, hinv t ht]
      exact Or.inr (Or.inl rfl)
    · rw [ha, hinv u hu]
      exact Or.inr (Or.inr (Or.inl rfl))
    · rw [ha, hinv (t * u) hp]
      exact Or.inr (Or.inr (Or.inr rfl))

theorem orbit_klein_mem_closure_pair
    {G : Type*} [Group G] (hG : ExponentFour G)
    (hno : ¬ HasD8Section G) (x t : G) (ht : t * t = 1) :
    orbitKleinSubgroup t (x * t * x⁻¹) ht
      (conjugate_involution ht)
      (local_orbit_involutions_commute hG hno x t ht) ≤
      Subgroup.closure ({x, t} : Set G) := by
  intro z hz
  change z = 1 ∨ z = t ∨ z = x * t * x⁻¹ ∨
    z = t * (x * t * x⁻¹) at hz
  rcases hz with rfl | rfl | rfl | rfl
  · exact Subgroup.one_mem _
  · exact Subgroup.subset_closure (by simp)
  · exact conjugate_mem_closure_pair x t
  · exact orbit_product_mem_closure_pair x t

/-- When `x` moves `t`, all four normal forms are distinct, so the
orbit subgroup really has four elements. -/
theorem orbit_klein_card_four
    {G : Type*} [Group G] (hG : ExponentFour G)
    (hno : ¬ HasD8Section G) {x t : G}
    (ht : t * t = 1) (hne : x * t ≠ t * x) :
    Nat.card (orbitKleinSubgroup t (x * t * x⁻¹) ht
      (conjugate_involution ht)
      (local_orbit_involutions_commute hG hno x t ht)) = 4 := by
  classical
  let u : G := x * t * x⁻¹
  let K : Subgroup G := orbitKleinSubgroup t u ht
    (conjugate_involution ht)
    (local_orbit_involutions_commute hG hno x t ht)
  have hd := moved_involution_four_distinct ht hne
  have ht1 : t ≠ 1 := hd.1
  have hu1 : u ≠ 1 := hd.2.1
  have hut : u ≠ t := hd.2.2.1
  have hp1 : t * u ≠ 1 := hd.2.2.2.1
  have hpt : t * u ≠ t := hd.2.2.2.2.1
  have hpu : t * u ≠ u := hd.2.2.2.2.2
  have hset : (K : Set G) = ↑({1, t, u, t * u} : Finset G) := by
    ext z
    change (z = 1 ∨ z = t ∨ z = u ∨ z = t * u) ↔
      z ∈ ({1, t, u, t * u} : Finset G)
    simp only [Finset.mem_insert, Finset.mem_singleton]
  change (K : Set G).ncard = 4
  rw [hset, Set.ncard_coe_finset]
  simp [ht1, ht1.symm, hu1, hu1.symm, hut, hut.symm,
    hp1, hp1.symm, hpt, hpt.symm, hpu, hpu.symm]

end KrebsSankarQ53
