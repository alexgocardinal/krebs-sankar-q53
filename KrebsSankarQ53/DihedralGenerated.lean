import KrebsSankarQ53.DihedralEight

/-!
# The subgroup generated by two involutions

The eight normal forms are exactly the subgroup generated by the two
involutions. In particular, noncommuting involutions in an exponent-four
group generate a subgroup of order eight.
-/

namespace KrebsSankarQ53

/-- The normal-form subgroup is generated by its two reflections. -/
theorem dihedralNormalFormSubgroup_eq_closure_pair
    {G : Type*} [Group G] {a b : G}
    (ha : a * a = 1) (hb : b * b = 1) :
    dihedralNormalFormSubgroup a b ha hb =
      Subgroup.closure ({a, b} : Set G) := by
  let P : Subgroup G := dihedralNormalFormSubgroup a b ha hb
  let Q : Subgroup G := Subgroup.closure ({a, b} : Set G)
  have haQ : a ∈ Q := Subgroup.subset_closure (by simp)
  have hbQ : b ∈ Q := Subgroup.subset_closure (by simp)
  have hR : Subgroup.zpowers (a * b) ≤ Q :=
    Subgroup.zpowers_le.mpr (Q.mul_mem haQ hbQ)
  apply le_antisymm
  · intro x hx
    change x ∈ Subgroup.zpowers (a * b) ∨
      ∃ t : Subgroup.zpowers (a * b), x = (t : G) * a at hx
    rcases hx with hx | ⟨t, ht⟩
    · exact hR hx
    · rw [ht]
      exact Q.mul_mem (hR t.property) haQ
  · apply (Subgroup.closure_le P).mpr
    intro x hx
    have hx' : x = a ∨ x = b := by simpa using hx
    rcases hx' with rfl | rfl
    · exact first_involution_mem_dihedralNormalFormSubgroup ha hb
    · exact second_involution_mem_dihedralNormalFormSubgroup ha hb

/-- Two noncommuting involutions in an exponent-four group generate exactly
eight elements. -/
theorem noncommuting_involutions_closure_card_eight
    {G : Type*} [Group G] (hG : ExponentFour G)
    {a b : G} (ha : a * a = 1) (hb : b * b = 1)
    (hne : a * b ≠ b * a) :
    Nat.card (Subgroup.closure ({a, b} : Set G)) = 8 := by
  rw [← dihedralNormalFormSubgroup_eq_closure_pair ha hb]
  exact dihedralNormalFormSubgroup_card_eight hG ha hb hne

end KrebsSankarQ53
