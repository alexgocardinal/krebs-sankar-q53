import KrebsSankarQ53.PairCore

/-!
# Two-generator commutator identities

These identities locate the central squares and commutator inside the
subgroup generated by their two inputs. They prepare the quotient
construction used in the remaining classification argument.
-/

namespace KrebsSankarQ53

theorem commutatorTerm_mul_reverse
    {G : Type*} [Group G] (x y : G) :
    commutatorTerm x y * (y * x) = x * y := by
  dsimp [commutatorTerm]
  group

theorem no_d8_section_pair_product_square
    {G : Type*} [Group G] (hG : ExponentFour G)
    (hno : ¬ HasD8Section G) (x y : G) :
    (x * y) ^ 2 = commutatorTerm x y * (x ^ 2 * y ^ 2) := by
  rw [commutatorTerm_eq_squares x y
    (no_d8_section_squares_central hG hno x y)]
  group

theorem pair_core_mem_closure
    {G : Type*} [Group G] (x y : G) :
    x ^ 2 ∈ Subgroup.closure ({x, y} : Set G) ∧
    y ^ 2 ∈ Subgroup.closure ({x, y} : Set G) ∧
    commutatorTerm x y ∈ Subgroup.closure ({x, y} : Set G) := by
  let H : Subgroup G := Subgroup.closure ({x, y} : Set G)
  have hx : x ∈ H := Subgroup.subset_closure (by simp)
  have hy : y ∈ H := Subgroup.subset_closure (by simp)
  refine ⟨?_, ?_, ?_⟩
  · simpa only [pow_two] using H.mul_mem hx hx
  · simpa only [pow_two] using H.mul_mem hy hy
  · change x * y * x⁻¹ * y⁻¹ ∈ H
    exact H.mul_mem (H.mul_mem (H.mul_mem hx hy) (H.inv_mem hx)) (H.inv_mem hy)

end KrebsSankarQ53
