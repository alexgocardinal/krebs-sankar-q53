import KrebsSankarQ53.D8NormalForms

/-!
# Evaluating concrete D8 words in two involutions

The numerical label `i + 4j` stands for `r^i a^j`, where `r = a*b`
and `a,b` are involutions. The map lands in their generated subgroup.
Its multiplication law and the resulting group isomorphism are separate
proof obligations.
-/

namespace KrebsSankarQ53

/-- Evaluate a concrete D8 element as a rotation, possibly followed by `a`. -/
def d8Word {G : Type*} [Group G] (a b : G) (x : D8) : G :=
  (a * b) ^ (x.val.val % 4) * (if x.val.val < 4 then 1 else a)

/-- The evaluated word lies in the subgroup generated by the two involutions. -/
def d8WordInClosure {G : Type*} [Group G] (a b : G)
    (x : D8) : Subgroup.closure ({a, b} : Set G) := by
  let Q : Subgroup G := Subgroup.closure ({a, b} : Set G)
  have ha : a ∈ Q := Subgroup.subset_closure (by simp)
  have hb : b ∈ Q := Subgroup.subset_closure (by simp)
  have hr : a * b ∈ Q := Q.mul_mem ha hb
  have hp : (a * b) ^ (x.val.val % 4) ∈ Q := Q.pow_mem hr _
  refine ⟨d8Word a b x, ?_⟩
  by_cases h : x.val.val < 4
  · simpa only [d8Word, if_pos h, mul_one] using hp
  · simpa only [d8Word, if_neg h] using Q.mul_mem hp ha

theorem d8Word_first {G : Type*} [Group G] (a b : G) :
    d8Word a b d8First = a := by
  simp [d8Word, d8First]

theorem d8Word_second {G : Type*} [Group G]
    (hG : ExponentFour G) {a b : G}
    (ha : a * a = 1) (hb : b * b = 1) :
    d8Word a b d8Second = b := by
  have h4 : (a * b) ^ 4 = 1 := hG (a * b)
  have h3 : (a * b) ^ 3 = (a * b)⁻¹ := by
    calc
      (a * b) ^ 3 = ((a * b) ^ 3 * (a * b)) * (a * b)⁻¹ := by
        simp [mul_assoc]
      _ = (a * b) ^ 4 * (a * b)⁻¹ := by rw [← pow_succ]
      _ = (a * b)⁻¹ := by rw [h4]; simp
  calc
    d8Word a b d8Second = (a * b) ^ 3 * a := by
      simp [d8Word, d8Second]
    _ = (a * b)⁻¹ * a := by rw [h3]
    _ = b := by
      rw [mul_inv_rev, involution_inv hb, involution_inv ha]
      simp [mul_assoc, ha]

end KrebsSankarQ53
