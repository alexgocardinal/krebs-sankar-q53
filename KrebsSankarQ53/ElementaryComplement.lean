import KrebsSankarQ53.QuaternionCover
import Mathlib.Algebra.Module.ZMod

/-!
# Splitting an involution off an elementary abelian group

Regard an arbitrary elementary abelian two-group as a vector space over
F2. A complement to the line generated by a specified nonidentity
element supplies the direct factor needed in the classification.
The complemented-submodule theorem uses classical choice and imposes
no finite-dimensionality hypothesis.
-/

namespace KrebsSankarQ53

theorem elementaryAbelian_exists_complement
    {T : Type*} [CommGroup T] (hT : ∀ t : T, t * t = 1)
    (z : T) (hz : z ≠ 1) :
    ∃ E : Subgroup T, z ∉ E ∧
      ∀ t : T, ∃ e ∈ E, t = e ∨ t = z * e := by
  classical
  let A := Additive T
  letI : Module (ZMod 2) A := AddCommGroup.zmodModule (n := 2)
    (fun a => by simpa only [two_nsmul] using hT (Additive.toMul a))
  let U : Submodule (ZMod 2) A := Submodule.span (ZMod 2) {Additive.ofMul z}
  obtain ⟨V, hUV⟩ := exists_isCompl U
  let E : Subgroup T :=
    { carrier := {t | Additive.ofMul t ∈ V}
      one_mem' := V.zero_mem
      mul_mem' := fun ha hb => V.add_mem ha hb
      inv_mem' := fun ha => V.neg_mem ha }
  have hzU : Additive.ofMul z ∈ U := Submodule.subset_span (by simp)
  have hzE : z ∉ E := by
    intro hze
    have hm : Additive.ofMul z ∈ U ⊓ V := ⟨hzU, hze⟩
    rw [hUV.inf_eq_bot] at hm
    have he : Additive.ofMul z = 0 := by simpa only [Submodule.mem_bot] using hm
    exact hz he
  refine ⟨E, hzE, ?_⟩
  intro t
  have ht : Additive.ofMul t ∈ U ⊔ V := by rw [hUV.sup_eq_top]; trivial
  obtain ⟨u, hu, v, hv, huv⟩ := Submodule.mem_sup.mp ht
  have hu' : u = 0 ∨ u = Additive.ofMul z := by
    obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp hu
    fin_cases a
    · left; simpa using ha.symm
    · right; simpa using ha.symm
  refine ⟨Additive.toMul v, hv, ?_⟩
  have heq : t = Additive.toMul u * Additive.toMul v :=
    congrArg Additive.toMul huv.symm
  rcases hu' with hu' | hu'
  · left
    rw [heq, hu']
    simp
  · right
    rw [heq, hu']

end KrebsSankarQ53
