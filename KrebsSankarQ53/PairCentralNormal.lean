import KrebsSankarQ53.PairCentralSubgroup

/-!
# Normality of the two-generator central subgroup

The central subgroup generated by the two squares and the commutator
is normal both in the ambient group and in the subgroup generated by
the pair. The latter supplies the quotient used in the paper.
-/

namespace KrebsSankarQ53

theorem no_d8_section_pairCentralSubgroup_normal
    {G : Type*} [Group G] (hG : ExponentFour G)
    (hno : ¬ HasD8Section G) (x y : G) :
    (pairCentralSubgroup x y).Normal := by
  refine ⟨?_⟩
  intro n hn g
  have hc : n * g = g * n :=
    no_d8_section_pairCentralSubgroup_central hG hno x y g ⟨n, hn⟩
  have heq : g * n * g⁻¹ = n := by
    calc
      g * n * g⁻¹ = (n * g) * g⁻¹ := by rw [← hc]
      _ = n := by group
  rw [heq]
  exact hn

theorem no_d8_section_pairCentralSubgroup_normal_in_pair
    {G : Type*} [Group G] (hG : ExponentFour G)
    (hno : ¬ HasD8Section G) (x y : G) :
    ((pairCentralSubgroup x y).subgroupOf
      (Subgroup.closure ({x, y} : Set G))).Normal := by
  refine ⟨?_⟩
  intro n hn g
  have hnC : (n : G) ∈ pairCentralSubgroup x y := hn
  have hc : (n : G) * (g : G) = (g : G) * (n : G) :=
    no_d8_section_pairCentralSubgroup_central hG hno x y g ⟨n, hnC⟩
  have heq : (g : G) * (n : G) * (g : G)⁻¹ = n := by
    calc
      (g : G) * (n : G) * (g : G)⁻¹ =
          ((n : G) * (g : G)) * (g : G)⁻¹ := by rw [← hc]
      _ = n := by group
  change (g : G) * (n : G) * (g : G)⁻¹ ∈ pairCentralSubgroup x y
  rw [heq]
  exact hnC

end KrebsSankarQ53
