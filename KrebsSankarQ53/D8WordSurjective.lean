import KrebsSankarQ53.D8WordHom

/-!
# Surjectivity of the D8 word homomorphism

The concrete generators map to the two generators of the target subgroup.
Since the range is a subgroup, it contains their closure.
-/

namespace KrebsSankarQ53

/-- Every element generated by two involutions is the image of a concrete
element of D8. -/
theorem d8WordHom_surjective {G : Type*} [Group G]
    (hG : ExponentFour G) {a b : G}
    (ha : a * a = 1) (hb : b * b = 1) :
    Function.Surjective (d8WordHom hG ha hb) := by
  let H : Subgroup G := Subgroup.closure ({a, b} : Set G)
  let f : D8 →* H := d8WordHom hG ha hb
  let g : D8 →* G := H.subtype.comp f
  have hgen : ({a, b} : Set G) ⊆ g.range := by
    intro z hz
    have hz' : z = a ∨ z = b := by simpa using hz
    rcases hz' with hza | hzb
    · change ∃ y : D8, g y = z
      refine ⟨d8First, ?_⟩
      change d8Word a b d8First = z
      exact (d8Word_first a b).trans hza.symm
    · change ∃ y : D8, g y = z
      refine ⟨d8Second, ?_⟩
      change d8Word a b d8Second = z
      exact (d8Word_second hG ha hb).trans hzb.symm
  have hclosure : H ≤ g.range :=
    (Subgroup.closure_le g.range).2 hgen
  intro x
  have hx : (x : G) ∈ g.range := hclosure x.property
  obtain ⟨y, hy⟩ := (MonoidHom.mem_range).1 hx
  refine ⟨y, Subtype.ext ?_⟩
  change d8Word a b y = (x : G)
  exact hy

end KrebsSankarQ53
