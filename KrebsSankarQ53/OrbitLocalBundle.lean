import KrebsSankarQ53.OrbitFourDistinct

/-!
# Local subgroup data around a moved involution

The two conjugate involutions and their product lie in the subgroup
generated by the conjugator and the original involution. Under the
no-D8-section hypothesis, their product and the conjugator's square
are nontrivial central involutions in that local subgroup.
-/

namespace KrebsSankarQ53

theorem conjugate_mem_closure_pair
    {G : Type*} [Group G] (x t : G) :
    x * t * x⁻¹ ∈ Subgroup.closure ({x, t} : Set G) := by
  let H : Subgroup G := Subgroup.closure ({x, t} : Set G)
  have hx : x ∈ H := Subgroup.subset_closure (by simp)
  have ht : t ∈ H := Subgroup.subset_closure (by simp)
  exact H.mul_mem (H.mul_mem hx ht) (H.inv_mem hx)

theorem orbit_product_mem_closure_pair
    {G : Type*} [Group G] (x t : G) :
    involutionOrbitProduct x t ∈
      Subgroup.closure ({x, t} : Set G) := by
  let H : Subgroup G := Subgroup.closure ({x, t} : Set G)
  have ht : t ∈ H := Subgroup.subset_closure (by simp)
  exact H.mul_mem ht (conjugate_mem_closure_pair x t)

theorem square_mem_closure_pair
    {G : Type*} [Group G] (x t : G) :
    x ^ 2 ∈ Subgroup.closure ({x, t} : Set G) := by
  let H : Subgroup G := Subgroup.closure ({x, t} : Set G)
  have hx : x ∈ H := Subgroup.subset_closure (by simp)
  simpa only [pow_two] using H.mul_mem hx hx

theorem local_orbit_involutions_commute
    {G : Type*} [Group G] (hG : ExponentFour G)
    (hno : ¬ HasD8Section G) (x t : G) (ht : t * t = 1) :
    t * (x * t * x⁻¹) = (x * t * x⁻¹) * t := by
  exact no_d8_section_involutions_commute hG hno t
    (x * t * x⁻¹) ht (conjugate_involution ht)

theorem local_orbit_central_involutions
    {G : Type*} [Group G] (hG : ExponentFour G)
    (hno : ¬ HasD8Section G) {x t : G} (ht : t * t = 1)
    (hne : x * t ≠ t * x) :
    x ^ 2 ∈ Subgroup.closure ({x, t} : Set G) ∧
    involutionOrbitProduct x t ∈ Subgroup.closure ({x, t} : Set G) ∧
    x ^ 2 ≠ 1 ∧ involutionOrbitProduct x t ≠ 1 ∧
    x ^ 2 * x ^ 2 = 1 ∧
    involutionOrbitProduct x t * involutionOrbitProduct x t = 1 ∧
    (∀ y : Subgroup.closure ({x, t} : Set G),
      (y : G) * x ^ 2 = x ^ 2 * (y : G)) ∧
    (∀ y : Subgroup.closure ({x, t} : Set G),
      (y : G) * involutionOrbitProduct x t =
        involutionOrbitProduct x t * (y : G)) := by
  exact ⟨square_mem_closure_pair x t,
    orbit_product_mem_closure_pair x t,
    noncentral_involution_conjugator_order_four hG hno ht hne,
    involutionOrbitProduct_ne_one_of_noncommute ht hne,
    square_is_involution hG x,
    involutionOrbitProduct_involution hG hno x t ht,
    square_centralizes_two_generator_subgroup_of_no_d8 hG hno x t ht,
    involutionOrbitProduct_centralizes_two_generator_subgroup hG hno x t ht⟩

end KrebsSankarQ53
