import KrebsSankarQ53.DihedralNormalForm

/-!
# The eight normal forms

For noncommuting involutions in an exponent-four group, the rotation
subgroup has four elements. Its right coset by a reflection is disjoint
and also has four elements, so their union has eight elements.
-/

namespace KrebsSankarQ53

/-- The first involution lies in the normal-form subgroup. -/
theorem first_involution_mem_dihedralNormalFormSubgroup
    {G : Type*} [Group G] {a b : G}
    (ha : a * a = 1) (hb : b * b = 1) :
    a ∈ dihedralNormalFormSubgroup a b ha hb := by
  change a ∈ Subgroup.zpowers (a * b) ∨
    ∃ t : Subgroup.zpowers (a * b), a = (t : G) * a
  exact Or.inr ⟨1, by simp⟩

/-- The second involution also lies in the normal-form subgroup. -/
theorem second_involution_mem_dihedralNormalFormSubgroup
    {G : Type*} [Group G] {a b : G}
    (ha : a * a = 1) (hb : b * b = 1) :
    b ∈ dihedralNormalFormSubgroup a b ha hb := by
  let R : Subgroup G := Subgroup.zpowers (a * b)
  have hr : a * b ∈ R :=
    Subgroup.mem_zpowers_iff.mpr ⟨1, by simp⟩
  change b ∈ R ∨ ∃ t : R, b = (t : G) * a
  right
  refine ⟨⟨(a * b)⁻¹, R.inv_mem hr⟩, ?_⟩
  change b = (a * b)⁻¹ * a
  rw [mul_inv_rev, involution_inv hb, involution_inv ha]
  simp [mul_assoc, ha]

/-- The subgroup generated by the rotations and one reflection has eight
elements under the exponent-four and noncommutation hypotheses. -/
theorem dihedralNormalFormSubgroup_card_eight
    {G : Type*} [Group G] (hG : ExponentFour G)
    {a b : G} (ha : a * a = 1) (hb : b * b = 1)
    (hne : a * b ≠ b * a) :
    Nat.card (dihedralNormalFormSubgroup a b ha hb) = 8 := by
  classical
  let R : Subgroup G := Subgroup.zpowers (a * b)
  let P : Subgroup G := dihedralNormalFormSubgroup a b ha hb
  have hcardR : Nat.card R = 4 :=
    noncommuting_involutions_rotation_subgroup_card hG ha hb hne
  haveI : Finite R :=
    (Nat.card_pos_iff.mp (by rw [hcardR]; omega)).2
  have hRfinite : (R : Set G).Finite := Set.toFinite _
  have hTfinite : ((fun x : G => x * a) '' (R : Set G)).Finite :=
    hRfinite.image _
  have hdisjoint : Disjoint (R : Set G)
      ((fun x : G => x * a) '' (R : Set G)) := by
    apply Set.disjoint_left.mpr
    intro z hzR hzT
    rcases hzT with ⟨y, hy, rfl⟩
    exact (rotation_reflection_coset_disjoint ha hne
      ⟨y * a, hzR⟩ ⟨y, hy⟩) rfl
  have hcarrier : (P : Set G) = (R : Set G) ∪
      ((fun x : G => x * a) '' (R : Set G)) := by
    ext z
    constructor
    · intro hz
      change z ∈ R ∨ ∃ t : R, z = (t : G) * a at hz
      rcases hz with hz | ⟨t, ht⟩
      · exact Or.inl hz
      · exact Or.inr ⟨t, t.property, ht.symm⟩
    · intro hz
      change z ∈ R ∨ ∃ t : R, z = (t : G) * a
      rcases hz with hz | ⟨y, hy, hzy⟩
      · exact Or.inl hz
      · exact Or.inr ⟨⟨y, hy⟩, hzy.symm⟩
  have hRcard : (R : Set G).ncard = 4 := by
    rw [← Nat.card_coe_set_eq]
    exact hcardR
  have hTcard : ((fun x : G => x * a) '' (R : Set G)).ncard =
      (R : Set G).ncard :=
    Set.ncard_image_of_injective _ (fun _ _ h => mul_right_cancel h)
  change (P : Set G).ncard = 8
  rw [hcarrier, Set.ncard_union_eq hdisjoint hRfinite hTfinite,
    hTcard, hRcard]

end KrebsSankarQ53
