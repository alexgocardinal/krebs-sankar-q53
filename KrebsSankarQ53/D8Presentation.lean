import KrebsSankarQ53.DihedralGenerated
import KrebsSankarQ53.D8Group

/-!
# The concrete generators of D8

The multiplication table in `Witness` is used here to identify two
noncommuting involutions and the exponent-four property of the concrete
eight-element group. These facts will be inputs to the isomorphism with
the subgroup generated by an arbitrary such pair.
-/

namespace KrebsSankarQ53

/-- The concrete reflection `s`. -/
def d8First : D8 := ⟨4⟩

/-- The reflection `r⁻¹s`, chosen so their product is `r`. -/
def d8Second : D8 := ⟨7⟩

theorem d8First_involution : d8First * d8First = 1 := by
  apply D8.ext
  decide

theorem d8Second_involution : d8Second * d8Second = 1 := by
  apply D8.ext
  decide

theorem d8First_second_product : d8First * d8Second = (⟨1⟩ : D8) := by
  apply D8.ext
  decide

theorem d8First_second_noncommute :
    d8First * d8Second ≠ d8Second * d8First := by
  decide

theorem d8_exponent_four : ExponentFour D8 := by
  intro x
  rcases x with ⟨v⟩
  fin_cases v <;> apply D8.ext <;> decide

end KrebsSankarQ53
