import KrebsSankarQ53.ExponentFourCore

/-!
# Relations generated by two involutions

These relations are used in constructing the D8 subgroup when two
involutions fail to commute. The construction itself is a later step.
-/

namespace KrebsSankarQ53

/-- One involution conjugates their product to its inverse. -/
theorem involution_reflects_product {G : Type*} [Group G]
    {a b : G} (ha : a * a = 1) (hb : b * b = 1) :
    a * (a * b) * a = (a * b)⁻¹ := by
  calc
    a * (a * b) * a = (a * a) * (b * a) := by group
    _ = b * a := by rw [ha]; simp
    _ = (a * b)⁻¹ := by rw [mul_inv_rev, involution_inv hb, involution_inv ha]

/-- The second involution gives the same reflection relation. -/
theorem involution_reflects_product_right {G : Type*} [Group G]
    {a b : G} (ha : a * a = 1) (hb : b * b = 1) :
    b * (a * b) * b = (a * b)⁻¹ := by
  calc
    b * (a * b) * b = (b * a) * (b * b) := by group
    _ = b * a := by rw [hb]; simp
    _ = (a * b)⁻¹ := by rw [mul_inv_rev, involution_inv hb, involution_inv ha]

/-- The product is a genuine fourfold rotation when the involutions do not commute. -/
theorem noncommuting_involutions_rotation_order_four
    {G : Type*} [Group G] (hG : ExponentFour G)
    {a b : G} (ha : a * a = 1) (hb : b * b = 1)
    (hne : a * b ≠ b * a) : orderOf (a * b) = 4 := by
  obtain ⟨h4, h2⟩ := noncommuting_involutions_product_order_four hG ha hb hne
  apply (orderOf_eq_iff (by decide : 0 < 4)).2
  refine ⟨h4, ?_⟩
  intro m hm hpos hpow
  have hm_cases : m = 1 ∨ m = 2 ∨ m = 3 := by omega
  rcases hm_cases with h | h | h
  · subst m
    have ht : a * b = 1 := by simpa using hpow
    apply h2
    rw [ht]
    simp
  · subst m
    exact h2 hpow
  · subst m
    have ht : a * b = 1 := by
      calc
        a * b = (a * b) ^ 3 * (a * b) := by rw [hpow]; simp
        _ = (a * b) ^ 4 := (pow_succ (a * b) 3).symm
        _ = 1 := h4
    apply h2
    rw [ht]
    simp

/-- The four rotations form a subgroup with exactly four elements. -/
theorem noncommuting_involutions_rotation_subgroup_card
    {G : Type*} [Group G] (hG : ExponentFour G)
    {a b : G} (ha : a * a = 1) (hb : b * b = 1)
    (hne : a * b ≠ b * a) :
    Nat.card (Subgroup.zpowers (a * b)) = 4 := by
  rw [Nat.card_zpowers]
  exact noncommuting_involutions_rotation_order_four hG ha hb hne

/-- A reflecting involution is outside the subgroup generated by the rotation. -/
theorem involution_not_mem_rotation_subgroup
    {G : Type*} [Group G] {a b : G}
    (ha : a * a = 1) (hne : a * b ≠ b * a) :
    a ∉ Subgroup.zpowers (a * b) := by
  intro hmem
  obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hmem
  have hcomm : a * (a * b) = (a * b) * a := by
    calc
      a * (a * b) = (a * b) ^ k * (a * b) ^ (1 : ℤ) := by rw [hk]; simp
      _ = (a * b) ^ (1 : ℤ) * (a * b) ^ k := zpow_mul_comm (a * b) k 1
      _ = (a * b) * a := by rw [hk]; simp
  have hb : b = (a * b) * a := by
    calc
      b = a * (a * b) := by rw [← mul_assoc, ha]; simp
      _ = (a * b) * a := hcomm
  apply hne
  calc
    a * b = (a * b) * (a * a) := by rw [ha]; simp
    _ = ((a * b) * a) * a := (mul_assoc (a * b) a a).symm
    _ = b * a := by rw [← hb]

end KrebsSankarQ53
