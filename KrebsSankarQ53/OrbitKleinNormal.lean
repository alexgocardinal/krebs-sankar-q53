import KrebsSankarQ53.OrbitSquareOutside

/-!
# Normality of the four-element orbit subgroup

The conjugator interchanges the two orbit involutions; its inverse
does the same. The original involution lies in the orbit subgroup.
Thus both generators normalize the orbit subgroup, which is normal
in the subgroup generated by those two elements.
-/

namespace KrebsSankarQ53

theorem orbit_klein_stable_under_inverse_conjugator
    {G : Type*} [Group G] (hG : ExponentFour G)
    (hno : ¬ HasD8Section G) (x t : G) (ht : t * t = 1)
    (a : G)
    (ha : a ∈ orbitKleinSubgroup t (x * t * x⁻¹) ht
      (conjugate_involution ht)
      (local_orbit_involutions_commute hG hno x t ht)) :
    x⁻¹ * a * x ∈ orbitKleinSubgroup t (x * t * x⁻¹) ht
      (conjugate_involution ht)
      (local_orbit_involutions_commute hG hno x t ht) := by
  change a = 1 ∨ a = t ∨ a = x * t * x⁻¹ ∨
    a = t * (x * t * x⁻¹) at ha
  change x⁻¹ * a * x = 1 ∨ x⁻¹ * a * x = t ∨
    x⁻¹ * a * x = x * t * x⁻¹ ∨
    x⁻¹ * a * x = t * (x * t * x⁻¹)
  rcases ha with ha | ha | ha | ha
  · rw [ha]
    exact Or.inl (by group)
  · rw [ha]
    have hswap : x⁻¹ * t * x = x * t * x⁻¹ := by
      calc
        x⁻¹ * t * x =
            x⁻¹ * (x * (x * t * x⁻¹) * x⁻¹) * x := by
              rw [conjugate_twice_involution_of_no_d8 hG hno x t ht]
        _ = x * t * x⁻¹ := by group
    exact Or.inr (Or.inr (Or.inl hswap))
  · rw [ha]
    exact Or.inr (Or.inl (by group))
  · rw [ha]
    have hcomm := involutionOrbitProduct_commutes_with_conjugator hG hno x t ht
    have hfix : x⁻¹ * (t * (x * t * x⁻¹)) * x =
        t * (x * t * x⁻¹) := by
      change x⁻¹ * involutionOrbitProduct x t * x =
        involutionOrbitProduct x t
      calc
        x⁻¹ * involutionOrbitProduct x t * x =
            x⁻¹ * (involutionOrbitProduct x t * x) := by group
        _ = x⁻¹ * (x * involutionOrbitProduct x t) := by rw [← hcomm]
        _ = involutionOrbitProduct x t := by group
    exact Or.inr (Or.inr (Or.inr hfix))

theorem orbit_klein_normalizer_contains_local_group
    {G : Type*} [Group G] (hG : ExponentFour G)
    (hno : ¬ HasD8Section G) (x t : G) (ht : t * t = 1) :
    Subgroup.closure ({x, t} : Set G) ≤
      Subgroup.normalizer
        (orbitKleinSubgroup t (x * t * x⁻¹) ht
          (conjugate_involution ht)
          (local_orbit_involutions_commute hG hno x t ht) : Set G) := by
  let A : Subgroup G := orbitKleinSubgroup t (x * t * x⁻¹) ht
    (conjugate_involution ht)
    (local_orbit_involutions_commute hG hno x t ht)
  have hx : x ∈ Subgroup.normalizer (A : Set G) := by
    rw [Subgroup.mem_normalizer_iff]
    intro a
    constructor
    · exact orbit_klein_stable_under_conjugator hG hno x t ht a
    · intro ha
      have hback := orbit_klein_stable_under_inverse_conjugator
        hG hno x t ht (x * a * x⁻¹) ha
      have heq : x⁻¹ * (x * a * x⁻¹) * x = a := by group
      rwa [heq] at hback
  have htA : t ∈ A := by
    change t = 1 ∨ t = t ∨ t = x * t * x⁻¹ ∨
      t = t * (x * t * x⁻¹)
    exact Or.inr (Or.inl rfl)
  have htn : t ∈ Subgroup.normalizer (A : Set G) :=
    (Subgroup.le_normalizer : A ≤ Subgroup.normalizer (A : Set G)) htA
  have hgen : ({x, t} : Set G) ⊆
      Subgroup.normalizer (A : Set G) := by
    intro z hz
    have hz' : z = x ∨ z = t := by simpa using hz
    rcases hz' with rfl | rfl
    · exact hx
    · exact htn
  exact (Subgroup.closure_le _).2 hgen

theorem orbit_klein_normal_in_local_group
    {G : Type*} [Group G] (hG : ExponentFour G)
    (hno : ¬ HasD8Section G) (x t : G) (ht : t * t = 1) :
    ((orbitKleinSubgroup t (x * t * x⁻¹) ht
      (conjugate_involution ht)
      (local_orbit_involutions_commute hG hno x t ht)).subgroupOf
      (Subgroup.closure ({x, t} : Set G))).Normal := by
  exact Subgroup.normal_subgroupOf_of_le_normalizer
    (orbit_klein_normalizer_contains_local_group hG hno x t ht)

end KrebsSankarQ53
