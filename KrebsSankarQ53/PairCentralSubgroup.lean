import KrebsSankarQ53.PairRelations

/-!
# The central elementary subgroup of a two-generator group

For a pair `x,y`, the subgroup generated by their two squares and
commutator is central and has exponent at most two in the no-D8 case.
-/

namespace KrebsSankarQ53

def pairCentralSubgroup {G : Type*} [Group G] (x y : G) : Subgroup G :=
  Subgroup.closure ({x ^ 2, y ^ 2, commutatorTerm x y} : Set G)

theorem pairCentralSubgroup_le_pair_closure
    {G : Type*} [Group G] (x y : G) :
    pairCentralSubgroup x y ≤ Subgroup.closure ({x, y} : Set G) := by
  have hcore := pair_core_mem_closure x y
  apply (Subgroup.closure_le (Subgroup.closure ({x, y} : Set G))).2
  intro z hz
  have hz' : z = x ^ 2 ∨ z = y ^ 2 ∨ z = commutatorTerm x y := by
    simpa only [Set.mem_insert_iff, Set.mem_singleton_iff] using hz
  rcases hz' with rfl | rfl | rfl
  · exact hcore.1
  · exact hcore.2.1
  · exact hcore.2.2

theorem no_d8_section_pairCentralSubgroup_le_involutions
    {G : Type*} [Group G] (hG : ExponentFour G)
    (hno : ¬ HasD8Section G) (x y : G) :
    pairCentralSubgroup x y ≤
      involutionSubgroup (no_d8_section_involutions_commute hG hno) := by
  have hcore := no_d8_section_pair_core_mem_involutions hG hno x y
  apply (Subgroup.closure_le
    (involutionSubgroup (no_d8_section_involutions_commute hG hno))).2
  intro z hz
  have hz' : z = x ^ 2 ∨ z = y ^ 2 ∨ z = commutatorTerm x y := by
    simpa only [Set.mem_insert_iff, Set.mem_singleton_iff] using hz
  rcases hz' with rfl | rfl | rfl
  · exact hcore.1
  · exact hcore.2.1
  · exact hcore.2.2

theorem no_d8_section_pairCentralSubgroup_square_one
    {G : Type*} [Group G] (hG : ExponentFour G)
    (hno : ¬ HasD8Section G) (x y : G)
    (z : pairCentralSubgroup x y) : (z : G) * z = 1 := by
  have hz := (no_d8_section_pairCentralSubgroup_le_involutions hG hno x y)
    z.property
  exact hz

theorem no_d8_section_pairCentralSubgroup_central
    {G : Type*} [Group G] (hG : ExponentFour G)
    (hno : ¬ HasD8Section G) (x y g : G)
    (z : pairCentralSubgroup x y) : (z : G) * g = g * z := by
  exact (no_d8_section_involutions_central hG hno g z
    (no_d8_section_pairCentralSubgroup_square_one hG hno x y z)).symm

end KrebsSankarQ53
