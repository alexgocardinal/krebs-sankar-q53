import KrebsSankarQ53.DihedralRelations

/-!
# Separating rotations and reflections

For two noncommuting involutions, the subgroup generated by their product
has four elements. Multiplication by either involution gives four different
elements outside that rotation subgroup. This is a step toward identifying
the subgroup generated by the pair with D8.
-/

namespace KrebsSankarQ53

/-- No rotation is a reflected rotation. -/
theorem rotation_reflection_coset_disjoint
    {G : Type*} [Group G] {a b : G}
    (ha : a * a = 1) (hne : a * b ≠ b * a)
    (x y : Subgroup.zpowers (a * b)) :
    (x : G) ≠ (y : G) * a := by
  intro hxy
  have hmem : (y : G)⁻¹ * (x : G) ∈ Subgroup.zpowers (a * b) :=
    (Subgroup.zpowers (a * b)).mul_mem
      ((Subgroup.zpowers (a * b)).inv_mem y.property) x.property
  have heq : (y : G)⁻¹ * (x : G) = a := by
    rw [hxy]
    group
  rw [heq] at hmem
  exact (involution_not_mem_rotation_subgroup ha hne) hmem

/-- Right multiplication by the reflection preserves distinct rotations. -/
theorem rotation_reflection_coset_injective
    {G : Type*} [Group G] {a b : G}
    (x y : Subgroup.zpowers (a * b))
    (hxy : (x : G) * a = (y : G) * a) : x = y := by
  apply Subtype.ext
  exact mul_right_cancel hxy

end KrebsSankarQ53
