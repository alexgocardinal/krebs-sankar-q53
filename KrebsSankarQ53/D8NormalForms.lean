import KrebsSankarQ53.D8Presentation

/-!
# Normal forms in the concrete D8 group

Each of the eight encoded elements is one of four powers of the rotation,
possibly followed by the reflection. This gives the concrete half of the
eventual isomorphism with a subgroup generated by two involutions.
-/

namespace KrebsSankarQ53

/-- The concrete eight-element group is equivalent, as a type, to `Fin 8`. -/
def d8EquivFin : D8 ≃ Fin 8 where
  toFun := D8.val
  invFun := D8.mk
  left_inv := by intro x; cases x; rfl
  right_inv := by intro x; rfl

theorem d8_nat_card : Nat.card D8 = 8 := by
  calc
    Nat.card D8 = Nat.card (Fin 8) := Nat.card_congr d8EquivFin
    _ = 8 := by simp

/-- Each element has a rotation or reflected-rotation normal form. -/
theorem d8_normal_forms (x : D8) :
    ∃ i : Fin 4,
      x = (d8First * d8Second) ^ i.val ∨
      x = (d8First * d8Second) ^ i.val * d8First := by
  rcases x with ⟨v⟩
  fin_cases v
  · exact ⟨0, Or.inl (by apply D8.ext; decide)⟩
  · exact ⟨1, Or.inl (by apply D8.ext; decide)⟩
  · exact ⟨2, Or.inl (by apply D8.ext; decide)⟩
  · exact ⟨3, Or.inl (by apply D8.ext; decide)⟩
  · exact ⟨0, Or.inr (by apply D8.ext; decide)⟩
  · exact ⟨1, Or.inr (by apply D8.ext; decide)⟩
  · exact ⟨2, Or.inr (by apply D8.ext; decide)⟩
  · exact ⟨3, Or.inr (by apply D8.ext; decide)⟩

/-- The two displayed involutions generate the whole concrete group. -/
theorem d8_pair_generates :
    Subgroup.closure ({d8First, d8Second} : Set D8) = ⊤ := by
  let Q : Subgroup D8 := Subgroup.closure ({d8First, d8Second} : Set D8)
  have ha : d8First ∈ Q := Subgroup.subset_closure (by simp)
  have hb : d8Second ∈ Q := Subgroup.subset_closure (by simp)
  have hr : d8First * d8Second ∈ Q := Q.mul_mem ha hb
  apply (Subgroup.eq_top_iff' Q).mpr
  intro x
  obtain ⟨i, h | h⟩ := d8_normal_forms x
  · rw [h]
    exact Q.pow_mem hr i.val
  · rw [h]
    exact Q.mul_mem (Q.pow_mem hr i.val) ha

end KrebsSankarQ53
